# Copy this file to  .streamlit/secrets.toml  and put your own key inside.
# secrets.toml is ignored by git, so your key stays private.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY = "YOUR_TMDB_API_KEY_HERE"
EMAIL_SENDER = "YOUR_EMAIL_HERE"
EMAIL_PASSWORD = "YOUR_16_DIGIT_APP_PASSWORD_HERE"